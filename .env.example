# PostgreSQL with the pgvector extension (docker compose up -d db gives you this one).
DATABASE_URL=postgresql://xk:xk@localhost:5432/xplorakodo

# Sign-in tokens and certificate signatures. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Admin account created on first start (change the password after the first login).
ADMIN_EMAIL=admin@xplorakodo.com
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Platform Admin
# Creates demo@xplorakodo.com / demo1234 for trying the student side. Set false in production.
SEED_DEMO=true

# LLM for grading, Ask Sensei and the Course Factory: openai (default) | anthropic | mock
# Without a key the app falls back to the offline deterministic mode automatically.
LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...

# LangSmith tracing + evals (smith.langchain.com → Settings → API keys)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=xplorakodo-tutor

# Kaggle ingestion (kaggle.com → Settings → API → Create New Token)
# KAGGLE_USERNAME=your-username
# KAGGLE_KEY=your-key
# KAGGLE_DATASETS=celineboutinon/jlpt-master-vocabulary-library-n5-n1,robinpourtaud/jlpt-words-by-level,balankdharan7/jlpt-n4-japanese-english-vocabulary-and-more
# Non-commercial (CC BY-NC) Kaggle rows are left out of model training unless this is true:
# ALLOW_NC_TRAINING=false

# Knowledge base bootstrap on start: background (default) | sync | off
# KB_BOOTSTRAP=background

# Embeddings for pgvector: hash (offline, 256-d) | openai (text-embedding-3-small at 256-d).
# After switching, run: python -m app.seed --reembed
EMBEDDING_PROVIDER=hash

# Public URL used inside certificate QR codes (optional; defaults to the request host).
# PUBLIC_BASE_URL=https://xplorakodo-tutor.onrender.com

# Tests use a separate, disposable database.
# TEST_DATABASE_URL=postgresql://xk:xk@localhost:5432/xplorakodo_test
